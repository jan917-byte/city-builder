# Python
__pycache__/
*.py[cod]

# Rendu régénérable (apercu_carte.py, 06, captures Godot), pas des sources
QGIS/rendus/

# Copies de travail des GeoPackages. Les .gpkg sont des binaires que git ne
# fusionne pas : la vraie carte ne s'écrit que sous Windows, et tout essai se
# fait sur une copie posée ici. Voir QGIS/data/bac/LISEZ-MOI.md.
QGIS/data/bac/*
!QGIS/data/bac/LISEZ-MOI.md

# Godot : cache d'import local, jamais partagé entre deux machines
Godot/.godot/
# L'export vers Godot est un DÉRIVÉ : 1,4 Mo régénérés en 3 s par 07. Le
# versionner ferait grossir l'historique à chaque relance de la chaîne, pour
# un fichier illisible en diff. On le régénère, on ne le transporte pas.
Godot/data/wehrau.json

# Claude (config locale)
.claude/settings.local.json

# Windows (personnalisation du dossier Bureau)
desktop.ini
folder-icon.ico
*.lnk
Thumbs.db

# macOS (métadonnées du Finder — ne doivent jamais partir vers Windows)
.DS_Store
._*

# Obsidian (état de session, pas le vault)
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json
